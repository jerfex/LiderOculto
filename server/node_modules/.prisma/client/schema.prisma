generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  players      Player[]
  roomsHosted  Room[]   @relation("RoomHost")
}

model Room {
  id         String    @id
  hostUserId String
  host       User      @relation("RoomHost", fields: [hostUserId], references: [id])
  state      RoomState @default(waiting)
  settings   Json
  createdAt  DateTime  @default(now())
  players    Player[]
  matches    Match[]
}

enum RoomState {
  waiting
  playing
  ended
}

model Player {
  id        String  @id @default(cuid())
  userId    String
  roomId    String
  role      Role
  posX      Int     @default(0)
  posY      Int     @default(0)
  connected Boolean @default(true)
  user      User    @relation(fields: [userId], references: [id])
  room      Room    @relation(fields: [roomId], references: [id])
}

enum Role {
  leader
  investigator
  observer
}

model Match {
  id           String     @id @default(cuid())
  roomId       String
  room         Room       @relation(fields: [roomId], references: [id])
  currentRound Int        @default(1)
  liesLeft     Int        @default(3)
  leaderUserId String
  endedAt      DateTime?
  questions    Question[]
  votes        Vote[]
}

model Question {
  id              String  @id @default(cuid())
  matchId         String
  match           Match   @relation(fields: [matchId], references: [id])
  round           Int
  text            String
  createdByUserId String
  answer          Answer?
}

model Answer {
  id         String   @id @default(cuid())
  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @unique
  value      Boolean
  usedLie    Boolean  @default(false)
}

model Vote {
  id          String @id @default(cuid())
  matchId     String
  match       Match  @relation(fields: [matchId], references: [id])
  round       Int
  voterUserId String
  targetX     Int
  targetY     Int
}
